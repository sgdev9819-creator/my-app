"use client";

import { useState, useRef, useEffect } from "react";

const items = [
  { name: "Item 1", text: "Description 1", image: "/color.png" },
  { name: "Item 2", text: "Description 2", image: "/color.png" },
  { name: "Item 3", text: "Description 3", image: "/color.png" },
  { name: "Item 4", text: "Description 4", image: "/color.png" },
  { name: "Item 5", text: "Description 5", image: "/color.png" },
];

export default function HeroSection() {
  const [isPlaying, setIsPlaying] = useState(true);
  const [isHovered, setIsHovered] = useState(false);

  const videoRef = useRef(null);
  const marqueeRef = useRef(null);
  
  // Animation Refs (use refs so updates inside rAF don't trigger re-renders)
  const positionRef = useRef(0);
  const animationFrameId = useRef(null);
  const currentSpeedRef = useRef(80); // Default speed in pixels/sec

  // Toggle Play / Pause for both Video and Marquee
  const togglePlay = () => {
    if (isPlaying) {
      videoRef.current?.pause();
      setIsPlaying(false);
    } else {
      videoRef.current?.play().catch(() => {});
      setIsPlaying(true);
    }
  };

  // Smoothly interpolate current speed towards target speed
  useEffect(() => {
    const targetSpeed = isHovered ? 250 : 80; // Speed when hovered vs normal
    let speedAnimationId;

    const transitionSpeed = () => {
      const diff = targetSpeed - currentSpeedRef.current;
      
      // Gradually ease speed towards target
      if (Math.abs(diff) > 0.5) {
        currentSpeedRef.current += diff * 0.05; // Adjust 0.05 for faster/slower acceleration curve
        speedAnimationId = requestAnimationFrame(transitionSpeed);
      } else {
        currentSpeedRef.current = targetSpeed;
      }
    };

    transitionSpeed();
    return () => cancelAnimationFrame(speedAnimationId);
  }, [isHovered]);

  // Main requestAnimationFrame Marquee Loop
  useEffect(() => {
    let lastTimestamp = null;

    const animateMarquee = (timestamp) => {
      if (!lastTimestamp) lastTimestamp = timestamp;
      const deltaTime = (timestamp - lastTimestamp) / 1000; // Time passed in seconds
      lastTimestamp = timestamp;

      if (isPlaying && marqueeRef.current) {
        // Calculate new position based on speed
        positionRef.current += currentSpeedRef.current * deltaTime;

        // Reset scroll position seamlessly when half the duplicated list passes
        const halfWidth = marqueeRef.current.scrollWidth / 2;
        if (positionRef.current >= halfWidth) {
          positionRef.current %= halfWidth;
        }

        // Apply hardware-accelerated transform
        marqueeRef.current.style.transform = `translateX(-${positionRef.current}px)`;
      }

      animationFrameId.current = requestAnimationFrame(animateMarquee);
    };

    // Start loop
    animationFrameId.current = requestAnimationFrame(animateMarquee);

    // Cleanup loop on unmount
    return () => cancelAnimationFrame(animationFrameId.current);
  }, [isPlaying]);

  return (
    <div className="w-full bg-black text-white py-10 flex flex-col gap-10">
      {/* 1. VIDEO SECTION */}
      <div className="relative w-full h-[32rem] flex justify-center items-center">
        <video
          ref={videoRef}
          src="large9.mp4"
          muted
          loop
          autoPlay
          playsInline
          className="w-full h-full object-cover"
        />

        {/* Play/Pause Control Button */}
        <button
          onClick={togglePlay}
          aria-label={isPlaying ? "Pause" : "Play"}
          className="absolute right-10 bottom-10 p-4 rounded-full border border-white/70 bg-white/10 backdrop-blur-md hover:bg-white/20 transition"
        >
          {isPlaying ? (
            <img src="/pause.svg" alt="Pause" className="w-4 h-4" />
          ) : (
            <img src="/play.svg" alt="Play" className="w-4 h-4" />
          )}
        </button>
      </div>

      {/* 2. INFINITE MARQUEE SECTION */}
      <div
        className="w-full overflow-hidden"
        onMouseEnter={() => setIsHovered(true)}
        onMouseLeave={() => setIsHovered(false)}
      >
        <div ref={marqueeRef} className="flex gap-4 w-max will-change-transform">
          {/* Duplicate the array ([...items, ...items]) for continuous looping */}
          {[...items, ...items].map((item, index) => (
            <div
              key={index}
              className="w-[280px] h-[350px] bg-neutral-900 rounded-xl flex-shrink-0 p-4 flex flex-col justify-end"
            >
              <img
                src={item.image}
                alt={item.name}
                className="w-full h-[250px] object-cover rounded-lg mb-2"
              />
              <span className="font-bold">{item.name}</span>
              <span className="text-sm text-gray-400">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}